# Live AI is optional. With no key set, the app runs in Demo Mode.
# Copy this file to .env.local and set ONE of the keys below. Never commit it.

# Option 1: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Option 2: Vercel AI Gateway key (used only if ANTHROPIC_API_KEY is empty)
AI_GATEWAY_API_KEY=

# Optional model override.
# Defaults: claude-haiku-5-5 (Anthropic), anthropic/claude-haiku-5-5 (Gateway)
AI_MODEL=
